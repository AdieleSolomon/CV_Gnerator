# CV Generator - Environment Configuration
# ─────────────────────────────────────────────────────────────

# PAYSTACK CONFIGURATION
# Get your keys from: https://dashboard.paystack.com/#/settings/developer
# For testing: Use pk_test_* keys
# For production: Use pk_live_* keys

# Test/Development Paystack Public Key
PAYSTACK_PUBLIC_KEY_TEST=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Live/Production Paystack Public Key
PAYSTACK_PUBLIC_KEY_LIVE=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Current environment (test or live)
ENVIRONMENT=test
